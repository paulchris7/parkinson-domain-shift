% Colour theme derived from the ITNU Gemini colour theme, recoloured with the
% ENSA Marrakech blue and the Cadi Ayyad University ochre.

\definecolor{ENSAblue}{RGB}{22,49,104}
\definecolor{UCAochre}{RGB}{166,82,28}
\definecolor{headgray}{RGB}{236,239,245}
\definecolor{lightgray}{RGB}{243,244,247}

\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=ENSAblue}

\setbeamercolor{headline}{fg=black,bg=headgray}
\setbeamercolor{headline title}{fg=ENSAblue}
\setbeamercolor{headline rule}{bg=UCAochre}

\setbeamercolor{block title}{fg=ENSAblue,bg=white}
\setbeamercolor{block separator}{bg=black}
\setbeamercolor{block body}{fg=black,bg=white}

\setbeamercolor{block alerted title}{fg=UCAochre,bg=lightgray}
\setbeamercolor{block alerted separator}{bg=black}
\setbeamercolor{block alerted body}{fg=black,bg=lightgray}

\setbeamercolor{heading}{fg=black}
\setbeamercolor{item}{fg=UCAochre}

\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}

\setbeamercolor{footline}{fg=white,bg=ENSAblue}
\setbeamercolor{footer rule}{bg=UCAochre}
